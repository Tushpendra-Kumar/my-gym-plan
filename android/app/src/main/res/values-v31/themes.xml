<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AthleticGymTracker" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Strict Monochrome White & Black Brand Palette (Zero Purple) -->
        <item name="colorPrimary">@color/pure_black</item>
        <item name="colorPrimaryVariant">@color/pure_black</item>
        <item name="colorOnPrimary">@color/bg_white</item>
        <item name="colorSecondary">@color/surface_dark</item>
        <item name="colorSecondaryVariant">@color/pure_black</item>
        <item name="colorOnSecondary">@color/bg_white</item>
        <item name="android:colorPrimary">@color/pure_black</item>
        <item name="android:colorPrimaryDark">@color/pure_black</item>
        <item name="android:colorAccent">@color/pure_black</item>

        <!-- Clean White System Bars & Window Background -->
        <item name="android:statusBarColor">@color/bg_white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/bg_white</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/bg_white</item>

        <!-- Android 12+ Splash Screen Monochrome White & Black -->
        <item name="android:windowSplashScreenBackground">@color/bg_white</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/pure_black</item>
    </style>
</resources>
